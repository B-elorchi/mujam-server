# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000,http://localhost:8080

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mujam_db"

# JWT
JWT_ACCESS_SECRET=your-strong-access-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-strong-refresh-secret-key-here-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OpenAI (Legacy - now using Deepgram for STT)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Deepgram (Speech-to-Text)
DEEPGRAM_API_KEY=your-deepgram-api-key-here
AI_STT_MODEL=general

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend (Email)
RESEND_API_KEY=re-your-resend-api-key
EMAIL_FROM=noreply@mujam.com

# Admin
SUPER_ADMIN_EMAIL=admin@mujam.com
SUPER_ADMIN_PASSWORD=change-me-in-production