# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000,http://localhost:8080

# Database
# Local: localhost. Docker on the VPS: host.docker.internal (host Postgres, not a container).
DATABASE_URL="postgresql://postgres:password@localhost:5432/mujam_db"

# JWT
JWT_ACCESS_SECRET=your-strong-access-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-strong-refresh-secret-key-here-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OpenAI (Legacy - now using Deepgram for STT)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Deepgram (Speech-to-Text)
DEEPGRAM_API_KEY=your-deepgram-api-key-here
AI_STT_MODEL=general
# TTS — Deepgram Aura (English) + OpenRouter Gemini (Arabic via TTS_PROVIDER=auto)
AI_TTS_VOICE_EN=aura-2-thalia-en
KIDS_TTS_SPEED_EN=0.5
# AI_TTS_SPEED_EN=0.5
TTS_PROVIDER=auto
# deepgram | openrouter | auto
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_TTS_VOICE_EN=Zephyr
OPENROUTER_TTS_VOICE_AR=Zephyr

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend (Email)
RESEND_API_KEY=re-your-resend-api-key
EMAIL_FROM=noreply@mujam.com

# Admin
SUPER_ADMIN_EMAIL=admin@mujam.com
SUPER_ADMIN_PASSWORD=change-me-in-production

# Long-lived API key for automation (n8n) on /api/admin/invitations
# Generate a random secret (min 24 chars), e.g.: openssl rand -base64 32
# Auth headers: X-API-Key: <key>  OR  Authorization: ApiKey <key>
# Invites are attributed to SUPER_ADMIN_EMAIL (or INVITE_API_ACTOR_EMAIL if set).
# Rotate by changing this value and restarting the server. Do not commit real keys.
INVITE_API_KEY=
# INVITE_API_ACTOR_EMAIL=admin@mujam.com

# Temporary public registration (default false = invite-only).
# To open signup briefly: set true, redeploy/restart API; set false again later.
# Frontend reads GET /api/auth/registration-options — no frontend rebuild required for the toggle.
ALLOW_PUBLIC_SIGNUP=false
