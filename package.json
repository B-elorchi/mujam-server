{
  "name": "mujam-server",
  "version": "1.0.0",
  "description": "mujam - Language Learning Platform Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "media:stories": "ts-node scripts/generate-all-story-audio.ts",
    "media:sentences": "ts-node scripts/generate-all-audio.ts",
    "media:all": "ts-node scripts/generate-all-media-audio.ts",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
