generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  STUDENT
  ADMIN
  EDITOR
  AI_MANAGER
  MARKETER
  VIEWER
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum GameType {
  DRAG_DROP
  MULTIPLE_CHOICE
  AUDIO_MATCH
  FILL_BLANK
  MIXED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  PROMO
}

enum BroadcastTarget {
  ALL
  FREE_USERS
  PREMIUM_USERS
  BY_LEVEL
  INACTIVE
  CUSTOM
}

enum BroadcastChannel {
  IN_APP
  EMAIL
  PUSH
  ALL
}

enum AIMode {
  GUIDED
  FREE
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommunityMemberStatus {
  PENDING
  ACTIVE
  BANNED
}

enum CommunityMessageType {
  TEXT
  AUDIO
}

enum CommunityRoomType {
  PUBLIC
  PRACTICE
  QA
}

enum PracticeInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum InviteAccess {
  MOAJAM
  KIDS
  BOTH
}

// ─────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────

model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  passwordHash      String
  avatarUrl         String?
  role              UserRole         @default(STUDENT)
  plan              SubscriptionPlan @default(FREE)
  currentLevel      Int              @default(1)
  placementScore    Int              @default(0)
  isActive          Boolean          @default(true)
  emailVerified     Boolean          @default(false)
  /// Adult Moajam learning platform access (existing users default true)
  accessMoajam      Boolean          @default(true)
  /// Moajam Kids space access
  accessKids        Boolean          @default(false)
  /// Optional parent email (when kids access) — parent account with this email can view progress
  parentEmail       String?
  lastActiveAt      DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  refreshTokens     RefreshToken[]
  subscription      Subscription?
  placementTests    PlacementTest[]
  sentenceProgress  UserSentenceProgress[]
  gameProgress      UserGameProgress[]
  quizAttempts      UserQuizAttempt[]
  shadowingProgress UserShadowingProgress[]
  aiSessions        AISession[]
  certificate       Certificate?
  streak            UserStreak?
  achievements      UserAchievement[]
  notifications     UserNotification[]
  referralsMade         Referral[]       @relation("ReferrerRelation")
  referredBy            Referral?        @relation("ReferredRelation")
  levelCompletion       UserLevelCompletion[]
  aiUsageLogs           AIUsageLog[]
  communityMemberships         CommunityMember[]
  communityMessages            CommunityMessage[]
  sentPracticeInvitations      PracticeInvitation[] @relation("SentInvitations")
  receivedPracticeInvitations  PracticeInvitation[] @relation("ReceivedInvitations")
  dailyPathProgress            DailyPathProgress[]
  weeklyChallengeProgress      WeeklyChallengeProgress[]
  loginEvents                  LoginEvent[]
  sessions                     UserSession[]
  invitationsCreated           UserInvitation[] @relation("UserInvitationsCreated")
  kidsModuleProgress           KidsModuleProgress[]

  @@index([email])
  @@index([plan])
  @@index([lastActiveAt])
  @@index([parentEmail])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// USER INVITATIONS (invite-only registration)
// ─────────────────────────────────────────

model UserInvitation {
  id          String       @id @default(uuid())
  email       String
  tokenHash   String       @unique // sha256 of single-use invite token (never store raw token)
  access      InviteAccess @default(MOAJAM)
  parentEmail String? // optional when access includes KIDS — parent can view child progress
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  invitedById String
  createdAt   DateTime     @default(now())
  invitedBy   User         @relation("UserInvitationsCreated", fields: [invitedById], references: [id])

  @@index([email])
  @@index([expiresAt])
}

// ─────────────────────────────────────────
// SUBSCRIPTION & PAYMENTS
// ─────────────────────────────────────────

model Subscription {
  id                String   @id @default(uuid())
  userId            String   @unique
  plan              SubscriptionPlan
  priceMonthly      Float
  startDate         DateTime
  endDate           DateTime?
  trialEndsAt       DateTime?
  isActive          Boolean  @default(true)
  cancelledAt       DateTime?
  paymentReference  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────
// CONTENT: LEVELS & SENTENCES
// ─────────────────────────────────────────

model Level {
  id              Int           @id
  titleAr         String
  titleEn         String
  descriptionAr   String?
  icon            String?
  orderIndex      Int           @unique
  levelType       String        @default("sentences") // "sentences" | "grammar"
  isFree          Boolean       @default(false)
  isActive        Boolean       @default(true)
  sentences       Sentence[]
  games           Game[]
  quiz            LevelQuiz?
  stories         Story[]
  userCompletion  UserLevelCompletion[]
  aiScenarios     AIScenario[]
  grammarRules    GrammarRule[]
}

model Sentence {
  id              String   @id @default(uuid())
  levelId         Int
  textEn          String
  textAr          String
  audioUrlNormal  String?
  audioUrlSlow    String?
  orderIndex      Int
  grammarTipAr    String?
  grammarTipEn    String?
  pronounTipAr    String?
  grammarCategory String?
  difficultyNote  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  level           Level    @relation(fields: [levelId], references: [id])
  userProgress    UserSentenceProgress[]
  gameQuestions   GameQuestion[]
  quizQuestions   QuizQuestion[]

  @@unique([levelId, orderIndex])
  @@index([levelId])
}

model GrammarRule {
  id            String   @id @default(uuid())
  levelId       Int
  titleAr       String
  titleEn       String
  explanation   String
  examples      Json
  exercises     Json?
  orderIndex    Int
  isActive      Boolean  @default(true)
  level         Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@index([levelId])
}

model UserSentenceProgress {
  id           String    @id @default(uuid())
  userId       String
  sentenceId   String
  listened     Boolean   @default(false)
  completed    Boolean   @default(false)
  listenCount  Int       @default(0)
  completedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentence     Sentence  @relation(fields: [sentenceId], references: [id])

  @@unique([userId, sentenceId])
  @@index([userId])
}

model UserLevelCompletion {
  id              String    @id @default(uuid())
  userId          String
  levelId         Int
  sentencesDone   Int       @default(0)
  gamesDone       Int       @default(0)
  quizPassed      Boolean   @default(false)
  shadowingDone   Boolean   @default(false)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level           Level     @relation(fields: [levelId], references: [id])

  @@unique([userId, levelId])
}

// ─────────────────────────────────────────
// PLACEMENT TEST
// ─────────────────────────────────────────

model PlacementQuestion {
  id             String   @id @default(uuid())
  sentenceEn     String
  correctAr      String
  options        Json
  targetLevel    Int
  orderIndex     Int
  isActive       Boolean  @default(true)
}

model PlacementTest {
  id             String   @id @default(uuid())
  userId         String
  score          Int
  assignedLevel  Int
  answers        Json
  takenAt        DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// GAMES
// ─────────────────────────────────────────

model Game {
  id           String     @id @default(uuid())
  levelId      Int
  type         GameType
  titleAr      String
  difficulty   Difficulty @default(EASY)
  orderIndex   Int
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  level        Level      @relation(fields: [levelId], references: [id])
  questions    GameQuestion[]
  userProgress UserGameProgress[]

  @@index([levelId])
}

model GameQuestion {
  id             String   @id @default(uuid())
  gameId         String
  sentenceId     String?
  type           GameType?
  questionData   Json
  correctAnswer  String
  orderIndex     Int
  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sentence       Sentence? @relation(fields: [sentenceId], references: [id])

  @@index([gameId])
}

model UserGameProgress {
  id           String    @id @default(uuid())
  userId       String
  gameId       String
  score        Int       @default(0)
  completed    Boolean   @default(false)
  attempts     Int       @default(0)
  completedAt  DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game      @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
}

// ─────────────────────────────────────────
// QUIZZES
// ─────────────────────────────────────────

model LevelQuiz {
  id           String        @id @default(uuid())
  levelId      Int           @unique
  passScore    Int           @default(70)
  maxAttempts  Int           @default(3)
  timeLimit    Int?
  level        Level         @relation(fields: [levelId], references: [id])
  questions    QuizQuestion[]
  attempts     UserQuizAttempt[]
}

model QuizQuestion {
  id             String    @id @default(uuid())
  quizId         String
  sentenceId     String?
  type           GameType
  questionData   Json
  correctAnswer  String
  points         Int       @default(10)
  orderIndex     Int
  quiz           LevelQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  sentence       Sentence? @relation(fields: [sentenceId], references: [id])

  @@index([quizId])
}

model UserQuizAttempt {
  id           String    @id @default(uuid())
  userId       String
  quizId       String
  score        Int
  passed       Boolean
  answers      Json
  attemptedAt  DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         LevelQuiz @relation(fields: [quizId], references: [id])

  @@index([userId, quizId])
}

// ─────────────────────────────────────────
// SHADOWING
// ─────────────────────────────────────────

model Story {
  id            String   @id @default(uuid())
  levelId       Int
  titleAr       String
  titleEn       String?
  fullText      String
  audioUrl      String?
  wordsTiming   Json?
  orderIndex    Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  level         Level    @relation(fields: [levelId], references: [id])
  userProgress  UserShadowingProgress[]

  @@index([levelId])
}

model UserShadowingProgress {
  id             String    @id @default(uuid())
  userId         String
  storyId        String
  currentStep    Int       @default(1)
  accuracyScore  Int?
  attempts       Int       @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  story          Story     @relation(fields: [storyId], references: [id])

  @@unique([userId, storyId])
}

// ─────────────────────────────────────────
// AI CONVERSATIONS
// ─────────────────────────────────────────

model AIScenario {
  id              String     @id @default(uuid())
  levelId         Int
  nameAr          String
  descriptionAr   String
  systemPrompt    String
  openingMessage  String
  icon            String?
  isActive        Boolean    @default(true)
  usageCount      Int        @default(0)
  createdAt       DateTime   @default(now())
  level           Level      @relation(fields: [levelId], references: [id])
  sessions        AISession[]
}

model AISession {
  id              String    @id @default(uuid())
  userId          String
  scenarioId      String?
  mode            AIMode
  userLevel       Int
  messages        Json
  durationSeconds Int       @default(0)
  errorSummary    Json?
  tokensUsed      Int       @default(0)
  costUsd         Float     @default(0)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario        AIScenario? @relation(fields: [scenarioId], references: [id])

  @@index([userId])
  @@index([startedAt])
}

model AIUsageLog {
  id          String   @id @default(uuid())
  userId      String
  service     String
  /// Product feature key, e.g. kids_tts, kids_tts_bulk, chat, stt, tts
  feature     String?
  /// Provider slug: openrouter, deepgram, openai
  provider    String?
  /// Model or voice id, e.g. google/gemini-3.1-flash-tts-preview, aura-2-thalia-en
  model       String?
  /// Masked API key label — never store full keys (e.g. OpenRouter, Deepgram)
  keyLabel    String?
  tokens      Int?
  /// Input character count (TTS text length)
  characters  Int?
  outputBytes Int?
  durationMin Float?
  costUsd     Float
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([feature])
  @@index([provider])
  @@index([keyLabel])
  @@index([model])
}

model AISettings {
  id                String   @id @default("singleton")
  gptModel          String   @default("gpt-4o-mini")
  sttModel          String   @default("whisper-1")
  ttsModel          String   @default("tts-1")
  ttsVoice          String   @default("nova")
  temperature       Float    @default(0.7)
  systemPrompt      String
  correctionStyle   String   @default("balanced")
  formalityLevel    Int      @default(60)
  monthlyBudgetUsd  Float    @default(50)
  updatedAt         DateTime @updatedAt
}

// ─────────────────────────────────────────
// CERTIFICATE
// ─────────────────────────────────────────

model Certificate {
  id          String   @id @default(uuid())
  userId      String   @unique
  verifyCode  String   @unique
  pdfUrl      String?
  issuedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([verifyCode])
}

// ─────────────────────────────────────────
// STREAK & ACHIEVEMENTS
// ─────────────────────────────────────────

model UserStreak {
  id              String   @id @default(uuid())
  userId          String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastStudyDate   DateTime?
  freezesLeft     Int      @default(0)
  totalStudyDays  Int      @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// DAILY PATH & WEEKLY SPEAKING CHALLENGE
// ─────────────────────────────────────────

model DailyPathProgress {
  id             String   @id @default(uuid())
  userId         String
  date           String   // YYYY-MM-DD (UTC)
  levelId        Int
  sentenceIds    Json     // string[]
  gameId         String?
  storyId        String?
  scenarioId     String?
  aiPromptEn     String?
  sentencesDone  Boolean  @default(false)
  gameDone       Boolean  @default(false)
  shadowingDone  Boolean  @default(false)
  aiDone         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model WeeklyChallengeProgress {
  id          String   @id @default(uuid())
  userId      String
  weekKey     String   // e.g. 2026-W35
  challengeId String
  attempted   Boolean  @default(false)
  completed   Boolean  @default(false)
  score       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([userId])
}

// ─────────────────────────────────────────
// PLATFORM ENGAGEMENT (logins + sessions)
// ─────────────────────────────────────────

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// Approximate presence window. Extended via heartbeat while the tab is open.
/// A gap > SESSION_GAP_MS starts a new session.
model UserSession {
  id         String    @id @default(uuid())
  userId     String
  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([userId, lastSeenAt])
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  nameAr      String
  descAr      String
  icon        String
  condition   Json
  userEarned  UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model UserNotification {
  id         String           @id @default(uuid())
  userId     String
  title      String
  body       String
  type       NotificationType @default(INFO)
  actionUrl  String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model BroadcastMessage {
  id            String           @id @default(uuid())
  title         String
  body          String
  type          NotificationType
  channel       BroadcastChannel
  target        BroadcastTarget
  targetConfig  Json?
  actionUrl     String?
  icon          String?
  totalSent     Int              @default(0)
  totalOpened   Int              @default(0)
  scheduledAt   DateTime?
  sentAt        DateTime?
  createdBy     String
  createdAt     DateTime         @default(now())
}

// ─────────────────────────────────────────
// NEWS BANNER (learner top strip)
// ─────────────────────────────────────────

model NewsBanner {
  id         String   @id @default(uuid())
  messageAr  String
  linkUrl    String?
  isActive   Boolean  @default(true)
  orderIndex Int      @default(0)
  bgColor    String?  // e.g. #DC2626; null = default red
  textColor  String?  // e.g. #FFFFFF; null = white
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, orderIndex])
}

// ─────────────────────────────────────────
// KIDS COURSES (Moajam Kids modules + lessons)
// ─────────────────────────────────────────

model KidsModule {
  id         String             @id // e.g. "alphabet", "numbers"
  titleEn    String
  titleAr    String
  icon       String             // emoji key for UI
  color      String             // blue|sky|yellow|pink|green|purple|orange
  orderIndex Int                @unique
  isActive   Boolean            @default(true)
  progress   Int                @default(0) // 0-100 default display until per-child progress
  stars      Int                @default(0) // 0-3 default display
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  screens       KidsLessonScreen[]
  userProgress  KidsModuleProgress[]

  @@index([isActive, orderIndex])
}

model KidsModuleProgress {
  id          String     @id @default(uuid())
  userId      String
  moduleId    String
  stars       Int        @default(3) // 0-3 earned on completion
  minutesSpent Int       @default(8)
  completedAt DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      KidsModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@index([userId, completedAt])
}

model KidsLessonScreen {
  id         String     @id @default(uuid())
  moduleId   String
  type       String     // flashcard|listen|grid|matching|sort|speak|choice|complete
  orderIndex Int
  payload    Json       // screen fields matching frontend LessonScreen (minus type)
  module     KidsModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, orderIndex])
  @@index([moduleId])
}

// ─────────────────────────────────────────
// BLOG
// ─────────────────────────────────────────

model BlogPost {
  id           String     @id @default(uuid())
  title        String
  slug         String     @unique
  excerpt      String?
  content      String
  coverColor   String?
  category     String
  tags         String[]
  status       BlogStatus @default(DRAFT)
  authorId     String
  readingTime  Int        @default(5)
  views        Int        @default(0)
  metaDesc     String?
  keywords     String?
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([slug])
  @@index([status])
}

// ─────────────────────────────────────────
// LEADERBOARD
// ─────────────────────────────────────────

model LeaderboardEntry {
  id        String   @id @default(uuid())
  userId    String
  period    String
  points    Int      @default(0)
  rank      Int?
  updatedAt DateTime @updatedAt

  @@unique([userId, period])
  @@index([period, points])
}

// ─────────────────────────────────────────
// REFERRALS
// ─────────────────────────────────────────

model Referral {
  id           String    @id @default(uuid())
  referrerId   String
  referredId   String    @unique
  rewardGiven  Boolean   @default(false)
  rewardedAt   DateTime?
  createdAt    DateTime  @default(now())
  referrer     User      @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referred     User      @relation("ReferredRelation", fields: [referredId], references: [id])

  @@index([referrerId])
}

// ─────────────────────────────────────────
// ADMIN TEAM
// ─────────────────────────────────────────

model AdminInvitation {
  id        String   @id @default(uuid())
  email     String
  role      UserRole
  token     String   @unique
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// PLATFORM SETTINGS
// ─────────────────────────────────────────

model PlatformSettings {
  id                  String  @id @default("singleton")
  platformName        String  @default("معجَم")
  supportEmail        String  @default("support@mujam.com")
  maintenanceMode     Boolean @default(false)
  maintenanceMessage  String?
  freeAiLimit         Int     @default(3)
  freeLevelsCount     Int     @default(2)
  premiumMonthlyPrice Float   @default(9.99)
  premiumYearlyPrice  Float   @default(7.99)
  trialDays           Int     @default(7)
  featureFlags          Json    @default("{}")
  communityAutoAccept   Boolean @default(true)
  updatedAt             DateTime @updatedAt
}

// ─────────────────────────────────────────
// COMMUNITY
// ─────────────────────────────────────────

model CommunityRoom {
  id          String            @id @default(uuid())
  name        String
  nameAr      String
  description String?
  icon        String            @default("💬")
  type        CommunityRoomType @default(PUBLIC)
  isActive    Boolean           @default(true)
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  members     CommunityMember[]
  messages    CommunityMessage[]
  practiceInvitations PracticeInvitation[]
}

model CommunityMember {
  id         String                @id @default(uuid())
  userId     String
  roomId     String
  status     CommunityMemberStatus @default(ACTIVE)
  joinedAt   DateTime              @default(now())
  lastReadAt DateTime?
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  room       CommunityRoom         @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId])
  @@index([userId])
}

model CommunityMessage {
  id            String               @id @default(uuid())
  roomId        String
  userId        String
  type          CommunityMessageType @default(TEXT)
  content       String?
  audioUrl      String?
  audioDuration Int?
  createdAt     DateTime             @default(now())
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  room          CommunityRoom        @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
}

model PracticeInvitation {
  id            String                    @id @default(uuid())
  fromUserId    String
  toUserId      String
  privateRoomId String?
  status        PracticeInvitationStatus  @default(PENDING)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  fromUser      User                      @relation("SentInvitations", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User                      @relation("ReceivedInvitations", fields: [toUserId], references: [id], onDelete: Cascade)
  privateRoom   CommunityRoom?            @relation(fields: [privateRoomId], references: [id])

  @@index([toUserId, status])
  @@index([fromUserId])
}
